OPENROUTER_API_KEY=
# Development sample results only. Never enabled automatically on AI failures.
MOCK_VISION=false
VISION_MODELS=google/gemma-4-31b-it:free,qwen/qwen3-vl-8b-instruct,google/gemini-3-flash-preview,openai/gpt-4.1-mini,openai/gpt-4o-mini
# Explicit opt-in required for any model without :free, including a paid primary.
ALLOW_PAID_VISION_FALLBACK=false
VISION_TOTAL_TIMEOUT_SECONDS=60
VISION_MODEL_TIMEOUT_SECONDS=12

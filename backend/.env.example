# Fridgely local configuration template. Copy to .env and configure locally.
# Never commit .env or real credentials.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
MOCK_VISION=false
MOCK_RECIPES=false
VISION_TOTAL_TIMEOUT_SECONDS=90
RECIPE_TIMEOUT_SECONDS=90
# DATABASE_URL is optional; default storage is backend/fridge_scan.db.
